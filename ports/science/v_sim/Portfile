PortSystem          1.0
PortGroup           compilers 1.0

name                v_sim
version             3.7.2
revision            0
categories          science
license             Permissive

notes               "V_Sim is released under the CeCILL license, by installing\
                    this port you accept the terms of the CeCILL license.\
                    See the installed LICENSE file for details."

# depends on mesa->py27-xml2->python27->openssl, but nothing from openssl is actually used in XCrySDen
license_noconflict  openssl

maintainers         {chengcheng_Xiao @Chengcheng-Xiao}

description         V_Sim is a visualizer for electronic and structural \
                    properties of molecules and crystals.

long_description    V_Sim visualizes atomic structures such as crystals, \
                    grain boundaries and so on. The rendering is done \
                    in 3D with colored sphere to represent the atoms. The user \
                    can interact through many functions to choose the view, \
                    load densities, draw planes... Much of it is detailled in \
                    the user guide. Moreover V_Sim allows to export the view \
                    as image in PNG, SVG or more formats. V_Sim is licensed \
                    under the CeCILL license, which is a free software license \
                    adapted to both international and French legal matters and \
                    is compatible with the GNU GPL, see the installed LICENSE \
                    file for details.

homepage            https://l_sim.gitlab.io/v_sim
master_sites        https://l_sim.gitlab.io/v_sim/download/
distfiles           v_sim-3.7.2.tar.bz2
use_bzip2           yes

checksums           rmd160  c8b426be13a019e76381bacfb366d66dd7d6de78 \
                    sha256  9212e6321d8ad8188529b9fab543268489e2f37d96e3ae55fa90d47d8ba4e70c \
